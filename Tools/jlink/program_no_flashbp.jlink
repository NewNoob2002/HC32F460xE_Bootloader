connect
halt
exec DisableFlashBPs
exec EnableFlashDL
exec SetFlashDLNoRMWThreshold = 0
erase 0x00000000 0x00005FFF
loadbin /home/gtc/Desktop/workspace/HC32_PROJ/HC32F460xE_Bootloader/build/Debug/hc32f460_boot.bin 0x00000000
verifybin /home/gtc/Desktop/workspace/HC32_PROJ/HC32F460xE_Bootloader/build/Debug/hc32f460_boot.bin 0x00000000
mem32 0x00000000 8
ClrRESET
sleep 50
SetRESET
sleep 100
halt
mem32 0x00000000 8
mem32 0xE000ED88 1
exit
